# Copia este archivo como .env (no se versiona). Solo NOMBRES aquí; nunca valores reales.
# Con Supabase local, `supabase status` muestra los valores de desarrollo.

# Cliente (web / móvil / reloj). La clave anónima es pública por diseño; la RLS protege los datos.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# SOLO servidor (Edge Functions, procesos de confianza). Nunca en apps, navegador, repositorio ni logs.
SUPABASE_SERVICE_ROLE_KEY=

# Pruebas de integración del api-client
VIDA_IT=0
MAILPIT_URL=http://127.0.0.1:54324
